# ===== AI-Vision-Guardian 环境变量样例 =====
# 使用：copy .env.example .env 后把真实值填进去
# 代码读取顺序：环境变量 > 同目录 config_xxx.txt > 内置默认值

# ---------- Kimi（Moonshot AI）云端大模型 ----------
# 在 https://platform.moonshot.cn 申请；留空时自动回退到本地规则模板
# KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 飞书机器人 Webhook ----------
# 形如 https://open.feishu.cn/open-apis/bot/v2/hook/<token>
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-token

# ---------- MySQL ----------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password_here

# ---------- 日志级别 ----------
# LOG_LEVEL=INFO

# ---------- TTS 速率 (pyttsx3 setProperty rate) ----------
# 默认 165，范围 50 ~ 400
# TTS_RATE=165
